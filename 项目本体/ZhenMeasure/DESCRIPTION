Package: ZhenMeasure
Type: Package
Title: ZhenMeasure: Pig Feeding Station Data Standardization, Quality Control and Phenotype Toolkit
Version: 1.1.4
Authors@R: c(
    person(given = "LiaoYiHui", family = "", role = c("aut", "cre"), email = "yhliao@webmail.hzau.edu.cn"),
    person(given = "WeiYi", family = "", role = "aut"),
    person(given = "TangZhenShuang", family = "", role = "aut"),
    person(given = "YinLiLin", family = "", role = "aut")
